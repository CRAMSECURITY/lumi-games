{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumi-staging",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-20",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "ratelimits": [
    {
      "name": "EDGE_RATE",
      "namespace_id": "91002",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumi-staging-db",
      "database_id": "ac27ca99-ae9a-4ea4-882b-d2e64c34e261",
      "migrations_dir": "migrations"
    }
  ]
}
